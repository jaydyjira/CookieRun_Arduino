# Source video — 764 MB, far over GitHub's 100 MB file limit.
# Keep it local. Never commit video files.
*.mov
*.mp4
*.m4v

# Frames dumped for picking ROIs — regenerable, and they pile up fast
frame_*.png
frames/

# Debug overlay renders
debug_*.mp4
debug_*.avi

# Extracted brightness signal — 1.5 MB, regenerable from the video
# in one pass. Named specifically, not *.csv, so the small event list
# this produces can still be committed.
signal.csv

# Python
__pycache__/
*.pyc
.venv/
venv/
